#!name=蝦皮每日簽到
#!desc=自動簽到蝦皮獲得蝦幣，自動更新Cookie
#!system=ios

[Script]
蝦皮取得Cookie = type=http-request,pattern=https://(mall|shopee|games-dailycheckin)\.shopee\.tw/.*,script-path=https://raw.githubusercontent.com/howsingsong/surge-scripts/refs/heads/main/shopee_cookie.js,requires-body=0,max-size=0

蝦皮每日簽到 = type=cron,cronexp="0 9 * * *",script-path=https://raw.githubusercontent.com/howsingsong/surge-scripts/refs/heads/main/shopee_checkin.js,wake-up=1

[MITM]
hostname = %APPEND% *.shopee.tw
