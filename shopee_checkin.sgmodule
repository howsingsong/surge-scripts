#!name=蝦皮每日簽到
#!desc=自動簽到蝦皮獲得蝦幣
#!system=ios

[Script]
蝦皮取得Cookie = type=http-response,pattern=https://games-dailycheckin.shopee.tw/mkt/coins/api/v2/checkin_new,script-path=https://raw.githubusercontent.com/howsingsong/surge-scripts/refs/heads/main/shopee_cookie.js,requires-body=1,max-size=0

蝦皮每日簽到 = type=cron,cronexp="0 9 * * *",script-path=https://raw.githubusercontent.com/howsingsong/surge-scripts/refs/heads/main/shopee_checkin.js,wake-up=1

[MITM]
hostname = %APPEND% games-dailycheckin.shopee.tw
